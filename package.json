{
  "name": "flag-tag",
  "version": "1.0.0",
  "description": "Flag Tag",
  "scripts": {
    "start": "sdk-commands start",
    "start:server": "npx @dcl/hammurabi-server@next",
    "deploy": "sdk-commands deploy",
    "build": "sdk-commands build",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:dependencies": "node scripts/sdk-dependency-smoke.cjs",
    "test:cli": "npm run test:dependencies && npm run build && sdk-commands start --help && sdk-commands deploy --help",
    "upgrade-sdk": "npm install --save-dev @dcl/sdk@auth-server",
    "upgrade-sdk:next": "npm install --save-dev @dcl/sdk@next",
    "server-logs": "sdk-commands sdk-server-logs"
  },
  "devDependencies": {
    "@dcl/sdk": "^7.26.1-32860802198.commit-dae48fb",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "ts-jest": "^29.4.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=9.0.0"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "none"
  },
  "overrides": {
    "@dcl/sdk-commands": {
      "esbuild": "0.25.12",
      "undici": "6.27.0"
    },
    "@dcl/inspector": {
      "ts-deepmerge": "8.0.0"
    },
    "dcl-catalyst-client": {
      "cookie": "0.7.2"
    },
    "protobufjs": "7.6.5"
  },
  "dependencies": {
    "@dcl/js-runtime": "7.26.1-32860802198.commit-dae48fb",
    "sharp": "^0.34.5"
  }
}
